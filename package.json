{
  "name": "dsh-web-fetch-proxy",
  "version": "0.3.0",
  "description": "DSH 插件：让内置 web_fetch 经由本地代理（Clash/Mihomo 等）出网，绕过 TUN fake-ip 假地址被 SSRF 防护拦截的问题。本副本为本地补丁版：跟随系统代理/TUN 开关，并每 pollMs 重新判定一次，切换无需重启。 / DSH plugin that routes the built-in web_fetch through a local proxy. This local build adds a system-proxy/TUN switch gate plus periodic re-evaluation, so toggling Clash needs no restart. See PATCH.md.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./detect": "./lib/detect.js",
    "./harness": "./lib/harness.js",
    "./manager": "./lib/manager.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "PATCH.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-fetch",
    "proxy",
    "clash",
    "mihomo",
    "fake-ip",
    "网络代理"
  ],
  "license": "MIT",
  "author": "L65N71",
  "contributors": [
    "Tong317 <1499501762@users.noreply.github.com> (original work, v0.2.0)"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L65N71/dsh-web-fetch-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/L65N71/dsh-web-fetch-proxy/issues"
  },
  "homepage": "https://github.com/L65N71/dsh-web-fetch-proxy#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-http-proxy": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.5-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-http-proxy": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "category": "extension",
    "displayName": "Web Fetch 代理",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
